[Unit]
Description=TTC3018 camera and environment monitor (no CNC control)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/github/ttc3018-bot
EnvironmentFile=-%h/github/ttc3018-bot/.env
ExecStart=%h/github/ttc3018-bot/.venv/bin/python -u -m monitor.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
KillMode=control-group
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
